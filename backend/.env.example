# Copier ce fichier en .env sur le serveur et remplir les valeurs.
# Ne jamais committer le vrai .env.

DJANGO_SECRET_KEY=a-remplacer
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=canopee.coisnevalentin.be
DJANGO_CORS_ALLOWED_ORIGINS=https://canopee.coisnevalentin.be
DJANGO_CSRF_TRUSTED_ORIGINS=https://canopee.coisnevalentin.be
DJANGO_STATIC_ROOT=/var/www/canopee-static